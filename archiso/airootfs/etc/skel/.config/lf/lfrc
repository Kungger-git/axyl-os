# -- Display ----------------------------------------------------------------
set hidden false
set ignorecase true
set drawbox true
set borderfmt "[38;2;217;119;87m"
set ratios 1:3:4
set info size:time
set timefmt "2006-01-02 15:04"
set truncatechar "..."

# -- Open -------------------------------------------------------------------
cmd open ${{
    mime=$(file --mime-type "$f" -b)
    case "$mime" in
        image/*)         nsxiv "$f" ;;
        application/pdf) zathura "$f" ;;
        video/*|audio/*) mpv "$f" ;;
        *)               $EDITOR "$f" ;;
    esac
}}

# -- Keybindings ------------------------------------------------------------
map <enter>      open
map <backspace2> set hidden!
map .            set hidden!
map <c-r>        reload
map <c-l>        redraw