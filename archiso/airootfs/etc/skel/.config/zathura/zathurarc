set default-bg         "#1a1a2e"
set default-fg         "#e6e1d8"
set statusbar-bg       "#16213e"
set statusbar-fg       "#e6e1d8"
set inputbar-bg        "#16213e"
set inputbar-fg        "#e6e1d8"
set notification-bg    "#16213e"
set notification-fg    "#e6e1d8"
set notification-error-bg   "#ff5555"
set notification-error-fg   "#e6e1d8"
set notification-warning-bg "#f1fa8c"
set notification-warning-fg "#1a1a2e"
set highlight-color         "#d97757"
set highlight-active-color  "#e8927c"
set completion-bg           "#16213e"
set completion-fg           "#e6e1d8"
set completion-highlight-bg "#d97757"
set completion-highlight-fg "#1a1a2e"
set recolor                 true
set recolor-lightcolor      "#1a1a2e"
set recolor-darkcolor       "#e6e1d8"
set recolor-keephue         false

set font "JetBrains Mono 11"
set guioptions ""
set zoom-min 10
set zoom-step 10
set scroll-step 50
set pages-per-row 1
set statusbar-h-padding 8
set statusbar-v-padding 4
