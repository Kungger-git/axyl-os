#!/usr/bin/env bash
set -euo pipefail

# Claude color palette escape codes
RESET='\e[0m'
ACCENT='\e[38;2;217;119;87m'
MUTED='\e[38;2;110;114;144m'
FG='\e[38;2;230;225;216m'
RED='\e[38;2;255;85;85m'
GREEN='\e[38;2;80;250;123m'

clear

# ASCII banner
echo -e "${ACCENT}"
cat << 'BANNER'
     _   __  ____  __
    / | / / / /\ \/ /
   /  |/ / / /  \  /
  / /|  / / /___/ /
 /_/ |_/_/_____/_/
BANNER
echo -e "${MUTED}         Arch Linux, Configured.${RESET}"
echo ""

# System info
fastfetch 2>/dev/null || true
echo ""

# Wait for network
echo -e "${MUTED}Waiting for network...${RESET}"
timeout=30
count=0
while ! nmcli -t -f STATE general status 2>/dev/null | grep -q "connected"; do
    sleep 1
    count=$((count + 1))
    if [[ $count -ge $timeout ]]; then
        echo -e "${RED}Network not available. You can still open a shell and connect manually.${RESET}"
        break
    fi
done

if nmcli -t -f STATE general status 2>/dev/null | grep -q "connected"; then
    echo -e "${GREEN}Network connected.${RESET}"
fi
echo ""

# Menu
echo -e "${ACCENT}┌─────────────────────────────────┐${RESET}"
echo -e "${ACCENT}│       Axyl Linux Installer       │${RESET}"
echo -e "${ACCENT}└─────────────────────────────────┘${RESET}"
echo ""
echo -e "  ${ACCENT}[1]${FG} Guided installation ${MUTED}(archinstall)${RESET}"
echo -e "  ${ACCENT}[2]${FG} Open a shell ${MUTED}(manual / advanced)${RESET}"
echo -e "  ${ACCENT}[3]${FG} Exit to desktop${RESET}"
echo ""
echo -ne "${ACCENT}Choice [1-3]: ${RESET}"
read -r choice

case "$choice" in
    1)
        echo ""
        echo -e "${MUTED}Launching archinstall...${RESET}"
        sleep 0.5
        sudo archinstall
        ;;
    2)
        echo ""
        echo -e "${MUTED}Opening shell. Type 'exit' to return to the desktop.${RESET}"
        echo -e "${MUTED}Default credentials: user=axyl  password=axyl${RESET}"
        echo ""
        exec bash
        ;;
    3)
        ;;
    *)
        echo -e "${RED}Invalid choice.${RESET}"
        sleep 1
        exec "$0"
        ;;
esac

# Mark done so bspwmrc does not re-open this terminal on reload
touch /var/run/axyl-install-done 2>/dev/null || true
