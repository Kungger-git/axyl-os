#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    up)   pamixer -i 5 ;;
    down) pamixer -d 5 ;;
    mute) pamixer -t ;;
esac

vol=$(pamixer --get-volume)
muted=$(pamixer --get-mute)

if [ "$muted" = "true" ]; then
    dunstify -h string:synchronous:volume "Volume" "Muted"
else
    dunstify -h string:synchronous:volume -h int:value:"$vol" "Volume" "${vol}%"
fi
