#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run as root: sudo axyl-setup" >&2
    exit 1
fi
REALUSER="${SUDO_USER:-}"
if [[ -z "$REALUSER" || "$REALUSER" == "root" ]]; then
    echo "Run with sudo from your normal user account." >&2
    exit 1
fi

echo "==> Axyl post-install setup (Artix / runit)"

# Installed systems use the greeter, not the live ISO autologin.
cat > /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 7

[default_session]
command = "agreety --cmd /usr/local/bin/start-hyprland-session"
user = "greeter"
EOF

RUNIT_DEFAULT="/etc/runit/runsvdir/default"
mkdir -p "$RUNIT_DEFAULT"
for svc in dbus elogind NetworkManager greetd acpid bluetoothd; do
    [[ -d "/etc/runit/sv/$svc" ]] && ln -sf "/etc/runit/sv/$svc" "$RUNIT_DEFAULT/"
done

sudo -u "$REALUSER" xdg-user-dirs-update
if [[ -x "/home/$REALUSER/.config/theme/render.py" ]]; then
    sudo -u "$REALUSER" env HOME="/home/$REALUSER" \
        "/home/$REALUSER/.config/theme/render.py" || true
fi

echo ""
echo "Setup complete. Reboot to start the Hyprland desktop."
