#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run as root: sudo axyl-setup" >&2
    exit 1
fi

REALUSER="${SUDO_USER:-}"
if [[ -z "$REALUSER" ]]; then
    echo "Cannot determine target user. Run with sudo, not directly as root." >&2
    exit 1
fi

echo "==> Axyl post-install setup (Artix / runit)"

echo "  -> Updating XDG user directories..."
sudo -u "$REALUSER" xdg-user-dirs-update

echo "  -> Enabling greetd service..."
if [ -d /etc/runit/sv/greetd ]; then
    ln -sf /etc/runit/sv/greetd /etc/runit/runsvdir/default/greetd
    echo "  greetd enabled. It will start on next boot."
else
    echo "  Note: /etc/runit/sv/greetd not found."
    echo "  Install greetd-runit and run: ln -s /etc/runit/sv/greetd /etc/runit/runsvdir/default/"
fi

echo ""
echo "Setup complete. Reboot to start your Axyl desktop."
