#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run as root: sudo axyl-setup" >&2
    exit 1
fi
REALUSER="${SUDO_USER:-}"
if [[ -z "$REALUSER" || "$REALUSER" == "root" ]]; then
    echo "Run with sudo from your normal user account." >&2
    exit 1
fi

echo "==> Axyl Linux post-install setup"

# Installed systems use the greeter, not the live ISO autologin.
cat > /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 7

[default_session]
command = "agreety --cmd /usr/local/bin/start-hyprland-session"
user = "greeter"
EOF

if [ -d /run/systemd/system ]; then
    for svc in NetworkManager greetd bluetooth systemd-timesyncd getty@tty2 \
               tlp.service fstrim.timer; do
        if systemctl cat "$svc" &>/dev/null; then
            systemctl enable "$svc"
        fi
    done
    # Nothing in the desktop needs network-online.target. The Services menu can
    # turn the wait back on if a VPN or network filesystem needs it.
    systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
    systemctl set-default graphical.target
else
    # runit: enable by symlinking into runsvdir/default.
    install -d /etc/runit/runsvdir/default
    for svc in dbus NetworkManager greetd bluetoothd agetty-tty2 chrony tlp zramen axyl-tune; do
        if [ -d "/etc/runit/sv/$svc" ]; then
            ln -sf "/etc/runit/sv/$svc" "/etc/runit/runsvdir/default/$svc"
        fi
    done
    # runit ships gettys on tty1-tty6; keep only tty2 as the fallback console.
    for svc in agetty-tty1 agetty-tty3 agetty-tty4 agetty-tty5 agetty-tty6; do
        rm -f "/etc/runit/runsvdir/default/$svc"
    done
fi

sudo -u "$REALUSER" xdg-user-dirs-update
if [[ -x "/home/$REALUSER/.config/theme/render.py" ]]; then
    sudo -u "$REALUSER" env HOME="/home/$REALUSER" \
        "/home/$REALUSER/.config/theme/render.py" || true
fi

echo ""
echo "Setup complete. Reboot to start the Hyprland desktop."
