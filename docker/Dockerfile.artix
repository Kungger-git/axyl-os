FROM artixlinux/artixlinux:base-runit

# Curated, fast Artix mirrors. The base image's default list contains dead or
# very slow hosts, and a stale cached package DB breaks the live install when a
# galaxy package is rebuilt (e.g. ttf-jetbrains-mono-nerd).
RUN printf '%s\n' \
        'Server = https://mirrors.tuna.tsinghua.edu.cn/artixlinux/$repo/os/$arch' \
        'Server = https://mirrors.dotsrc.org/artix-linux/repos/$repo/os/$arch' \
        'Server = https://mirror1.artixlinux.org/repos/$repo/os/$arch' \
        'Server = https://mirror.clarkson.edu/artix-linux/repos/$repo/os/$arch' \
        > /etc/pacman.d/mirrorlist

# archiso and arch-install-scripts are not in Artix repos.
# Section must be named [extra] — pacman fetches <section>.db from the server,
# so a custom name like [arch-extra] would request a non-existent arch-extra.db.
# Artix has no [extra] repo of its own, so there is no conflict.
# SigLevel=Never: disposable build container only.
RUN echo '' >> /etc/pacman.conf && \
    echo '[extra]' >> /etc/pacman.conf && \
    echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' >> /etc/pacman.conf && \
    echo 'SigLevel = Never' >> /etc/pacman.conf

RUN pacman -Syy --noconfirm --needed \
        archiso \
        arch-install-scripts \
        dosfstools \
        e2fsprogs \
        libisoburn \
        mtools \
        squashfs-tools \
        syslinux \
        grub \
        mkinitcpio \
        git

# The container's native /etc/pacman.d/mirrorlist is left intact.
# It is the same mirrorlist that makes the pacman -S step above succeed quickly.
# artixiso/pacman.conf uses Include = /etc/pacman.d/mirrorlist so mkarchiso
# uses those same fast mirrors when installing live system packages.
