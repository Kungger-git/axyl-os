#!/usr/bin/env bash

# Restart sxhkd on bspwm reload
pkill -x sxhkd; sxhkd &

# ── Desktops ─────────────────────────────────────────────────────────────────
bspc monitor -d 1 2 3 4 5 6 7 8 9

# ── Window geometry ───────────────────────────────────────────────────────────
bspc config border_width         2
bspc config window_gap           8
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config single_monocle       false

# ── Claude color scheme borders ───────────────────────────────────────────────
bspc config normal_border_color   "#45475a"
bspc config active_border_color   "#d97757"
bspc config focused_border_color  "#d97757"
bspc config presel_feedback_color "#e8927c"

# ── Padding (polybar height 28 + 2 gap) ───────────────────────────────────────
bspc config top_padding    30
bspc config bottom_padding  0
bspc config left_padding    0
bspc config right_padding   0

# ── Window rules ──────────────────────────────────────────────────────────────
bspc rule -a mpv             state=floating rectangle=960x540+480+270
bspc rule -a flameshot       state=floating border=off
bspc rule -a Blueman-manager state=floating rectangle=700x500+540+210

# ── Autostart — critical (desktop visible immediately) ────────────────────────
# picom --daemon &    # compositor: disabled by default; enable for shadows/fading
feh --no-fehbg --bg-fill ~/.config/bspwm/wallpaper.jpg 2>/dev/null \
    || xsetroot -solid "#1a1a2e"
pipewire &
sleep 0.2
wireplumber &
pipewire-pulse &
for _i in 1 2 3 4 5; do pactl info >/dev/null 2>&1 && break; sleep 0.3; done
chmod +x ~/.config/polybar/launch.sh
~/.config/polybar/launch.sh &
dunst &

# ── Autostart — deferred 2 s (system daemons) ────────────────────────────────
(sleep 2
 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
 nm-applet &
 numlockx on &
 xss-lock -- /usr/local/bin/axyl-lock &) &


# Open installer terminal on first launch only
if [ ! -f "$HOME/.axyl-install-done" ]; then
    kitty --title "Axyl Installer" -e /usr/local/bin/axyl-install &
fi
