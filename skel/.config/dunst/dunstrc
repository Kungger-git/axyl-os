[global]
monitor                = 0
follow                 = mouse
width                  = (0, 350)
height                 = 200
origin                 = top-right
offset                 = 12x48
scale                  = 0
notification_limit     = 5
progress_bar           = true
progress_bar_height    = 8
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300
indicate_hidden        = yes
transparency           = 8
separator_height       = 1
padding                = 10
horizontal_padding     = 12
text_icon_padding      = 0
frame_width            = 1
frame_color            = "#d97757"
separator_color        = frame
sort                   = yes
font                   = JetBrains Mono 10
line_height            = 1
markup                 = full
format                 = "<b>%s</b>\n%b"
alignment              = left
vertical_alignment     = center
show_age_threshold     = 60
word_wrap              = yes
ellipsize              = middle
ignore_newline         = no
stack_duplicates       = true
hide_duplicate_count   = false
show_indicators        = yes
min_icon_size          = 16
max_icon_size          = 32
icon_theme             = Adwaita
enable_recursive_icon_lookup = true
sticky_history         = yes
history_length         = 20
dmenu                  = /usr/bin/rofi -dmenu -p dunst:
browser                = /usr/bin/xdg-open
always_run_script      = true
title                  = Dunst
class                  = Dunst
corner_radius          = 4
ignore_dbusclose       = false
mouse_left_click       = close_current
mouse_middle_click     = do_action, close_current
mouse_right_click      = close_all

[urgency_low]
background  = "#1a1a2e"
foreground  = "#e6e1d8"
frame_color = "#45475a"
timeout     = 4

[urgency_normal]
background  = "#1a1a2e"
foreground  = "#e6e1d8"
frame_color = "#d97757"
timeout     = 6

[urgency_critical]
background  = "#1a1a2e"
foreground  = "#ff5555"
frame_color = "#ff5555"
timeout     = 0
