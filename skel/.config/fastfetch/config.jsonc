{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/axyl.txt",
    "padding": { "right": 2 },
    "color": { "1": "#fab283", "2": "#9d7cd8" }
  },
  "display": {
    "separator": "  ",
    "key": { "type": "both-1", "width": 13 },
    "color": {
      "keys": "#fab283",
      "title": "#fab283",
      "output": "#eeeeee",
      "separator": "#808080"
    }
  },
  "modules": [
    { "type": "title", "color": { "user": "#fab283", "at": "#808080", "host": "#fab283" } },
    "break",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    { "type": "wm", "key": "WM" },
    "terminal",
    "shell",
    "cpu",
    "gpu",
    "memory",
    { "type": "localip", "key": "IP", "showPrefixLen": false },
    "battery"
  ]
}
