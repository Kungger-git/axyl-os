
/* GENERATED by ~/.config/theme/render.py -- do not edit by hand. */
/* Source of truth: ~/.config/theme/palette.json */

* {
  background-color: transparent;
  text-color: #eeeeee;
  font: "JetBrainsMono Nerd Font 14";
  border-radius: 10px;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 320px;
  background-color: rgba(10, 10, 10, 0.92);
  border: 1px solid;
  border-color: #484848;
  padding: 10px;
}

mainbox {
  background-color: transparent;
  spacing: 8px;
}

inputbar {
  background-color: #141414;
  border-radius: 8px;
  padding: 8px 10px;
  children: [prompt, entry];
}

prompt {
  text-color: #808080;
}

entry {
  text-color: #eeeeee;
}

listview {
  background-color: transparent;
  lines: 5;
  spacing: 8px;
  fixed-height: true;
}

element {
  padding: 10px;
  border-radius: 8px;
  text-color: #eeeeee;
}

element selected {
  background-color: #fab283;
  text-color: #0a0a0a;
}
