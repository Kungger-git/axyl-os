
/* GENERATED by ~/.config/theme/render.py -- do not edit by hand. */
/* Source of truth: ~/.config/theme/palette.json */

* {
  background-color: transparent;
  text-color: #eeeeee;
  font: "JetBrainsMono Nerd Font 12";
  border-radius: 10px;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 560px;
  background-color: rgba(10, 10, 10, 0.92);
  border: 1px solid;
  border-color: #484848;
  padding: 10px;
}

mainbox {
  background-color: transparent;
  spacing: 8px;
}

inputbar {
  background-color: #141414;
  border-radius: 8px;
  padding: 10px;
  children: [entry];
}

entry {
  text-color: #eeeeee;
  placeholder: "Search…";
  placeholder-color: #808080;
}

prompt {
  enabled: false;
}

listview {
  background-color: transparent;
  lines: 8;
  spacing: 4px;
  scrollbar: false;
}

element {
  padding: 8px;
  border-radius: 6px;
  text-color: #eeeeee;
}

element selected {
  background-color: #fab283;
  text-color: #0a0a0a;
}

element-icon {
  size: 1.2em;
}
