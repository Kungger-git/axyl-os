# ── Applications ─────────────────────────────────────────────────────────────
super + Return
    kitty

super + space
    rofi -show drun

super + e
    kitty -e lf

super + b
    qutebrowser

# ── Screenshots ───────────────────────────────────────────────────────────────
Print
    flameshot gui

super + Print
    flameshot screen -c

# ── Power / session ───────────────────────────────────────────────────────────
super + shift + e
    /usr/local/bin/axyl-powermenu

super + l
    axyl-lock

# ── bspwm ────────────────────────────────────────────────────────────────────
super + Escape
    pkill -USR1 -x sxhkd

super + shift + r
    bspc wm -r

super + alt + Escape
    bspc quit

# ── Close / kill ──────────────────────────────────────────────────────────────
super + shift + q
    bspc node -c

super + shift + k
    bspc node -k

# ── Focus / move (vim keys) ───────────────────────────────────────────────────
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# ── Cycle windows ─────────────────────────────────────────────────────────────
alt + {_,shift + }Tab
    bspc node -f {next,prev}.local.!hidden.window

# ── Navigate desktops ─────────────────────────────────────────────────────────
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# ── Last node / desktop ───────────────────────────────────────────────────────
super + {grave,Tab}
    bspc {node,desktop} -f last

# ── Focus history ─────────────────────────────────────────────────────────────
super + {o,i}
    bspc wm -h off; \
    bspc node {older,newer} -f; \
    bspc wm -h on

# ── Path navigation ───────────────────────────────────────────────────────────
super + {p,comma,period}
    bspc node -f @{parent,first,second}

# ── State / layout ────────────────────────────────────────────────────────────
super + {t,shift + t}
    bspc node -t {tiled,pseudo_tiled}

super + f
    bspc node -t ~fullscreen

super + shift + space
    bspc node -t ~floating

super + m
    bspc desktop -l next

super + r
    bspc node @/ -R 90

# ── Node flags ────────────────────────────────────────────────────────────────
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# ── Utility ───────────────────────────────────────────────────────────────────
super + y
    bspc node newest.marked.local -n newest.!automatic.local

super + g
    bspc node -s biggest.window

# ── Workspaces ────────────────────────────────────────────────────────────────
super + {1-9}
    bspc desktop -f '^{1-9}'

super + shift + {1-9}
    bspc node -d '^{1-9}'

# ── Preselect ─────────────────────────────────────────────────────────────────
super + ctrl + {h,j,k,l}
    bspc node -p {west,south,north,east}

super + ctrl + {1-9}
    bspc node -o 0.{1-9}

super + ctrl + space
    bspc node -p cancel

super + ctrl + shift + space
    bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# ── Resize ────────────────────────────────────────────────────────────────────
super + alt + {h,j,k,l}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

super + alt + shift + {h,j,k,l}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# ── Move floating window ──────────────────────────────────────────────────────
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# ── Audio ─────────────────────────────────────────────────────────────────────
XF86AudioRaiseVolume
    axyl-osd-volume up

XF86AudioLowerVolume
    axyl-osd-volume down

XF86AudioMute
    axyl-osd-volume mute

# ── Brightness ────────────────────────────────────────────────────────────────
XF86MonBrightnessUp
    axyl-osd-brightness up

XF86MonBrightnessDown
    axyl-osd-brightness down

# ── Media ─────────────────────────────────────────────────────────────────────
XF86AudioPlay
    playerctl play-pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous
